---
import Layout from '../layouts/Layout.astro';
import { content, priceLabel } from '../data/content';
import { offerActive } from '../../../backend/src/modules/content/model';
import LeadModal from '../components/LeadModal.astro';
const assetUrl=(item:{mediaId?:string;imageUrl?:string})=>item.imageUrl || (item.mediaId ? '/media/'+item.mediaId+'.webp' : undefined);
const heroImages=content.gallery.map(assetUrl).filter((url):url is string=>Boolean(url));
const heroImage=heroImages[0] || '/images/brushes.jpg';
---
<Layout title="Celebrity makeup artists in Janakpuri, Delhi" description="SandhyaVermaMakeovers: celebrity makeup artistry and a makeup academy in Janakpuri, West Delhi. Enquire about bridal, occasion makeup and learning.">
<section class="hero">
<div class="hero-copy"><span class="eyebrow"><span class="small-line"></span> {content.home.eyebrow}</span><h1>{content.home.title}<br /><em>{content.home.accent}</em></h1><p>{content.home.description}</p><div class="button-row"><a class="button" href="/services/">Explore makeup services <span>↗</span></a><a class="text-link" href="/academy/">Discover the academy ↗</a></div><div class="hero-location"><span class="star">✦</span><span>SANDHYA VERMA MAKEOVERS<small>Janakpuri, West Delhi</small></span></div></div>
<div class="hero-art"><img id="hero-portfolio-image" src={heroImage} alt="Featured makeup portfolio work" width="1000" height="1250" fetchpriority="high" /><div class="hero-art-shade"></div><span class="vertical-label">THE ART OF BECOMING</span><div class="art-caption"><span>Beauty, considered.</span><small>Featured portfolio image</small></div><span class="hero-orbit">SV</span></div>
</section>
<div class="ribbon"><span>BRIDAL ARTISTRY</span><i>✦</i><span>OCCASION MAKEUP</span><i>✦</i><span>CELEBRITY & EDITORIAL</span><i>✦</i><span>MAKEUP ACADEMY</span></div>
<section class="section-wrap section-space"><div class="section-head"><div><span class="eyebrow">01 / THE MAKEOVER EXPERIENCE</span><h2>Your occasion.<br /><em>Our artistry.</em></h2></div><div><p>Every look begins with a conversation. Tell us your story, your inspiration and how you want to feel.</p><a class="text-link" href="/services/">View all services ↗</a></div></div><div class="service-grid">{content.services.map((s,i)=><a class="service-card" href={'/services/'+s.id+'/'}><span class="card-number">0{i+1}</span><div class={'service-visual visual-'+i}>{assetUrl(s) ? <img src={assetUrl(s)} alt={s.title} loading="lazy" /> : <><span>{['B','O','E'][i]||'S'}</span><i>✦</i></>}</div><div class="card-body"><span class="eyebrow">{s.category}</span><h3>{s.title}</h3><p>{s.description}</p><div class="card-bottom"><span>{priceLabel(s.price)}</span><span aria-hidden="true">↗</span></div></div></a>)}</div></section>
<section class="academy-feature"><div class="academy-photo"><img src="/images/artistry.jpg" alt="Illustrative makeup brushes for learning makeup artistry" width="1000" height="1000" loading="lazy" /><span class="photo-credit">Illustrative image · Unsplash</span></div><div class="academy-copy"><span class="eyebrow">02 / THE ACADEMY</span><h2>A love for beauty.<br /><em>A skill for life.</em></h2><p>Curious about what happens on the other side of the brush? Explore makeup education at our academy in Janakpuri.</p><div class="academy-points"><span>01 <b>Explore your interests</b></span><span>02 <b>Find your learning path</b></span><span>03 <b>Enquire about the next batch</b></span></div><a class="button button-outline" href="/academy/">Step inside the academy <span>↗</span></a></div></section>
<section class="section-wrap section-space studio-note"><span class="eyebrow">THE SANDHYA VERMA APPROACH</span><h2>Makeup that celebrates<br /><em>who you are.</em></h2><p>A celebrity makeup perspective, a personal conversation, and attention to the details that matter to you.</p><a class="text-link" href="/about/">Meet the studio ↗</a></section>
{content.testimonials.length > 0 && <section class="section-wrap testimonial-section"><span class="eyebrow">KIND WORDS</span><h2>From the people<br /><em>we’ve had the joy to serve.</em></h2><div class="testimonial-grid">{content.testimonials.map(testimonial=><blockquote>{testimonial.preview && <span class="preview-content-label">PREVIEW CONTENT</span>}<p>“{testimonial.quote}”</p><footer>{assetUrl(testimonial) && <img class="testimonial-photo" src={assetUrl(testimonial)} alt="" loading="lazy" />}<span><strong>{testimonial.name}</strong>{testimonial.occasion && <span>{testimonial.occasion}</span>}</span></footer></blockquote>)}</div></section>}
{offerActive(content.offer,new Date()) && <aside class="offer-banner section-wrap" data-expires={content.offer.endsAt}><span class="eyebrow">AT THE STUDIO</span><h3>{content.offer.title}</h3><p>{content.offer.description}</p><small>Valid through {content.offer.endsAt}. Availability and terms confirmed by the team.</small><a href="/contact/" class="text-link">Enquire ↗</a></aside>}
<section class="cta-section section-wrap"><div><span class="eyebrow">LET’S MAKE IT PERSONAL</span><h2>Your next chapter<br /><em>starts here.</em></h2></div><a class="button" href="/contact/">Plan your visit <span>↗</span></a></section>
<LeadModal />
{heroImages.length > 1 && <script define:vars={{heroImages}}>const hero=document.querySelector<HTMLImageElement>('#hero-portfolio-image');if(hero&&!matchMedia('(prefers-reduced-motion: reduce)').matches){let index=0;window.setInterval(()=>{index=(index+1)%heroImages.length;hero.style.opacity='0';window.setTimeout(()=>{hero.src=heroImages[index];hero.style.opacity='1';},220);},6000);}</script>}
</Layout>
