---
import Layout from '../layouts/Layout.astro';
import { content, priceLabel } from '../data/content';
import { offerActive } from '../../../backend/src/modules/content/model';
import LeadModal from '../components/LeadModal.astro';
const assetUrl=(item:{mediaId?:string;imageUrl?:string})=>item.imageUrl || (item.mediaId ? '/media/'+item.mediaId+'.webp' : undefined);
const galleryHeroImages=content.gallery.map(assetUrl).filter((url):url is string=>Boolean(url));
const heroImages=[assetUrl(content.home),...galleryHeroImages].filter((url):url is string=>Boolean(url));
const heroImage=heroImages[0] || '/images/brushes.jpg';
const heroCollage=heroImages.slice(1,5);
const serviceFallbackImages=['/images/portfolio-bridal.webp','/images/generated/occasion-makeup-editorial.webp','/images/generated/editorial-makeup-still-life.webp'];
// Latest gallery uploads are the verified studio-event images selected by the owner.
const testimonialImages=content.gallery.map(assetUrl).filter((url):url is string=>Boolean(url)).slice(-3);
---
<Layout title="Celebrity makeup artist in Janakpuri, Delhi" description="Sandhya Verma Makeovers: celebrity, bridal, occasion and editorial makeup artistry in Janakpuri, West Delhi.">
<section class="hero">
<div class="hero-copy"><span class="eyebrow"><span class="small-line"></span> {content.home.eyebrow}</span><h1>{content.home.title}<br /><em>{content.home.accent}</em></h1><p>{content.home.description}</p><div class="button-row"><a class="button" href="/services/">Explore makeup services <span>↗</span></a><a class="text-link" href="/academy/">Discover the academy ↗</a></div><div class="hero-location"><span class="star">✦</span><span>SANDHYA VERMA MAKEOVERS<small>Janakpuri, West Delhi</small></span></div></div>
<div class="hero-art hero-art--animated"><img src={heroImage} alt="Featured makeup portfolio work" width="1000" height="1250" fetchpriority="high" />
  {heroCollage.length > 0 && <div class="hero-collage" aria-hidden="true">{heroCollage.map((image,index)=><img class={`hero-collage__image hero-collage__image--${index + 1}`} src={image} alt="" width="500" height="650" loading="eager" />)}</div>}
  <div class="hero-art-shade"></div><span class="vertical-label">THE ART OF BECOMING</span><div class="art-caption"><span>Beauty, considered.</span><small>Featured studio work</small></div><span class="hero-orbit">SV</span></div>
</section>
<div class="ribbon"><span>BRIDAL ARTISTRY</span><i>✦</i><span>OCCASION MAKEUP</span><i>✦</i><span>CELEBRITY & EDITORIAL</span><i>✦</i><span>MAKEUP ACADEMY</span></div>
<section class="section-wrap section-space"><div class="section-head"><div><span class="eyebrow">01 / THE MAKEOVER EXPERIENCE</span><h2>Your occasion.<br /><em>Our artistry.</em></h2></div><div><p>Every look begins with a conversation. Tell us your story, your inspiration and how you want to feel.</p><a class="text-link" href="/services/">View all services ↗</a></div></div><div class="service-grid">{content.services.map((s,i)=>{const image=assetUrl(s) || serviceFallbackImages[i % serviceFallbackImages.length];return <a class="service-card" href={'/services/'+s.id+'/'}><span class="card-number">0{i+1}</span><div class={'service-visual visual-'+i}><img src={image} alt={s.title} loading="lazy" /></div><div class="card-body"><span class="eyebrow">{s.category}</span><h3>{s.title}</h3><p>{s.description}</p><div class="card-bottom"><span>{priceLabel(s.price)}</span><span aria-hidden="true">↗</span></div></div></a>})}</div></section>
<section class="academy-feature"><div class="academy-photo"><img src="/images/artistry.jpg" alt="Illustrative makeup brushes for learning makeup artistry" width="1000" height="1000" loading="lazy" /><span class="photo-credit">Illustrative image · Unsplash</span></div><div class="academy-copy"><span class="eyebrow">02 / THE ACADEMY</span><h2>A love for beauty.<br /><em>A skill for life.</em></h2><p>Curious about what happens on the other side of the brush? Explore makeup education at our academy in Janakpuri.</p><div class="academy-points"><span>01 <b>Explore your interests</b></span><span>02 <b>Find your learning path</b></span><span>03 <b>Enquire about the next batch</b></span></div><a class="button button-outline" href="/academy/">Step inside the academy <span>↗</span></a></div></section>
<section class="section-wrap section-space studio-note"><span class="eyebrow">THE SANDHYA VERMA APPROACH</span><h2>Makeup that celebrates<br /><em>who you are.</em></h2><p>Celebrity artistry, a personal conversation and attention to the details that matter to you.</p><a class="text-link" href="https://www.instagram.com/sandhyavermamakeovers/" target="_blank" rel="noopener noreferrer">Follow the latest work on Instagram ↗</a></section>
{content.testimonials.length > 0 && <section class="section-wrap testimonial-section"><span class="eyebrow">KIND WORDS / STUDIO MOMENTS</span><h2>From the people<br /><em>we’ve had the joy to serve.</em></h2><div class="testimonial-grid">{content.testimonials.map((testimonial,index)=>{const image=assetUrl(testimonial) || testimonialImages[index % Math.max(testimonialImages.length,1)];return <blockquote>{image && <img class="testimonial-card-photo" src={image} alt="" loading="lazy" />}{testimonial.preview && <span class="preview-content-label">STUDIO MOMENT</span>}<p>“{testimonial.quote}”</p><footer>{image && <img class="testimonial-photo" src={image} alt="" loading="lazy" />}<span><strong>{testimonial.name}</strong>{testimonial.occasion && <span>{testimonial.occasion}</span>}</span></footer></blockquote>})}</div></section>}
{offerActive(content.offer,new Date()) && <aside class="offer-banner section-wrap" data-expires={content.offer.endsAt}><span class="eyebrow">AT THE STUDIO</span><h3>{content.offer.title}</h3><p>{content.offer.description}</p><small>Valid through {content.offer.endsAt}. Availability and terms confirmed by the team.</small><a href="/contact/" class="text-link">Enquire ↗</a></aside>}
<section class="cta-section section-wrap"><div><span class="eyebrow">LET’S MAKE IT PERSONAL</span><h2>Your next chapter<br /><em>starts here.</em></h2></div><a class="button" href="/contact/">Plan your visit <span>↗</span></a></section>
<LeadModal />
</Layout>
